rules_version = '2';

// Reglas de seguridad para Firebase Storage - GridProde F1
service firebase.storage {
  match /b/{bucket}/o {
    
    // Carpeta de avatares de pilotos:
    // - Lectura pública para cualquier visitante o participante
    // - Escritura, subida y eliminación restringida a usuarios con rol 'Administrador'
    match /avatars_pilotos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'Administrador' ||
        request.auth.token.admin == true
      );
    }

    // Regla general para el resto de archivos
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
