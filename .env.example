# Configuración de Firebase Web App
# Obtén estos valores en Firebase Console -> Configuración del proyecto -> Tus apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=tu_api_key_aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=tu_app_id

# Lista opcional de correos electrónicos que recibirán automáticamente el rol 'Administrador' al iniciar sesión
# Separados por comas, por ejemplo: admin@gridprode.com,tu-email@gmail.com
NEXT_PUBLIC_INITIAL_ADMIN_EMAILS=
