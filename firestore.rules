rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Perfiles de usuarios y subcolecciones de minijuegos
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrador');

      match /trivias/{triviaId} {
        allow read: if true;
        allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrador');
      }
    }
    
    // Escuderías y pilotos: lectura pública, escritura solo admin
    match /escuderias/{id} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrador';
    }
    match /pilotos/{id} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrador';
    }
    match /drivers_stats/{id} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrador';
    }
    
    // Carreras (grand_prix)
    match /grand_prix/{id} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrador';
    }
    
    // Predicciones
    match /predicciones/{predId} {
      allow read: if true;
      allow write: if request.auth != null && (request.resource.data.usuario_id == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrador');
    }

    // Trivias semanales
    match /trivias/{triviaId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /participantes/{userId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    match /trivia/{triviaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Leaderboard del Semáforo de Largada (Reacción)
    match /leaderboard_semaforo/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrador');
    }
  }
}
